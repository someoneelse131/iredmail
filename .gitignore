# Data directories (created at runtime)
data/

# Environment file with secrets.
# The timestamped-backup patterns matter: `*.bak` further down does NOT match a
# name like `.env.bak.20260617T085922Z` (it does not END in .bak), so a stale
# secrets backup sitting in the deploy dir showed up as untracked and was one
# `git add -A` away from being committed.
.env
.env.bak*
.env.*.bak
.env.*.backup

# fail2ban runtime state (ban database) — regenerated, never version it
config/fail2ban/db/

# SSL certificates
*.pem
*.key
*.crt

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Docker
.docker/

# Logs
*.log

# Backup files
# Same trap as the .env patterns above: `*.bak` does NOT match a timestamped
# name like `config.inc.php.bak-2026-08-25`, because it does not END in .bak.
*.bak
*.bak-*
*.bak.*
*.backup

# Temporary files
*.tmp
tmp/

# Claude AI development files
CLAUDE.md
.claude/
