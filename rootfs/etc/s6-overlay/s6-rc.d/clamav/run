#!/command/with-contenv bash
set -e

# Check if ClamAV is disabled
if [ "${DISABLE_CLAMAV}" = "YES" ]; then
    echo "ClamAV disabled, sleeping..."
    exec sleep infinity
fi

echo "Starting ClamAV daemon..."

# Create directories and ensure proper ownership
mkdir -p /run/clamav /var/log/clamav /var/lib/clamav
chown -R clamav:clamav /run/clamav /var/lib/clamav /var/log/clamav

# Clean stale files
rm -f /run/clamav/clamd.pid /run/clamav/clamd.ctl

# Signature database handling.
#
# Ongoing updates are NOT this script's job — the "freshclam" s6 service runs
# freshclam in daemon mode (hourly). This block is a pure BOOTSTRAP wait for the
# very first boot, when no database exists yet.
#
# What was here before: an unbounded `while pgrep -x freshclam; do sleep 2; done`
# plus an inline download gated on `[ ! -f main.cvd ]`. Both are wrong now:
#   - a permanently running freshclam daemon makes that pgrep loop block clamd
#     forever on every restart;
#   - freshclam converts .cvd to .cld after an incremental update, so testing
#     only main.cvd would re-download the whole set once the DB updates in place.
# freshclam stages downloads in a temp dir and renames them in, so starting
# clamd while an update is in flight is safe and needs no interlock.
db_present() {
    [ -f /var/lib/clamav/main.cvd ] || [ -f /var/lib/clamav/main.cld ]
}

if ! db_present; then
    echo "No virus definitions yet, waiting for the freshclam service to fetch them..."
    waited=0
    while ! db_present && [ "$waited" -lt 300 ]; do
        sleep 5
        waited=$((waited + 5))
        echo "  ... still waiting for signatures (${waited}s)"
    done
    if db_present; then
        echo "Virus definitions present after ${waited}s."
    else
        echo "WARNING: still no signature database after ${waited}s."
        echo "         Starting clamd anyway; it will fail to load and s6 will"
        echo "         retry until freshclam succeeds."
    fi
fi

echo "Starting clamd..."
exec /usr/sbin/clamd --foreground=true
